# ==============================================================================
# Ring Compass - Environment Configuration Template
# Copy this file to .env and configure with your local or test credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ring Developer Sandbox API Credentials
# ------------------------------------------------------------------------------
RING_CLIENT_ID=your_ring_client_id_here
RING_CLIENT_SECRET=your_ring_client_secret_here
RING_HMAC_SIGNATURE_KEY=your_hmac_signature_key_here

# ------------------------------------------------------------------------------
# 2. Local AI Engine (Ollama - Free Local Alternative to Cloud Bedrock)
# ------------------------------------------------------------------------------
OLLAMA_HOST="http://localhost:11434"

# ------------------------------------------------------------------------------
# 3. Weather & Context Telemetry
# ------------------------------------------------------------------------------
OPENWEATHER_API_KEY=your_openweather_api_key
TEST_ZIP_CODE="641001"

# ------------------------------------------------------------------------------
# 4. Smart Home Mesh (Home Assistant API Core)
# ------------------------------------------------------------------------------
HOME_ASSISTANT_URL="http://localhost:8123/api"
HOME_ASSISTANT_TOKEN="your_home_assistant_bearer_token"

# ------------------------------------------------------------------------------
# 5. Alexa Connected Hardware Edge Node (ESP32 Amber Pathway LED & Speaker)
# ------------------------------------------------------------------------------
ESP32_WIFI_SSID="Your_WiFi_SSID"
ESP32_WIFI_PASSWORD="Your_WiFi_Password"
ESP32_HOST="192.168.1.113"
ESP32_PORT="80"

# ------------------------------------------------------------------------------
# 6. Autonomous Emergency Dispatch (SMTP Caregiver Alerts)
# ------------------------------------------------------------------------------
EMAIL_ADDRESS="your_sender_email@gmail.com"
EMAIL_PASSWORD="your_google_app_password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
EMERGENCY_RECIPIENT="caregiver@example.com"
